rules_version = '2';

// VNext Football Hub Firestore Rules

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the requesting user has the 'admin' role.
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Function to check the global betting enabled status. Defaults to true if not set.
    function isBettingGloballyEnabled() {
      return get(/databases/$(database)/documents/appSettings/global).data.isBettingEnabled == true || !exists(/databases/$(database)/documents/appSettings/global);
    }
    
    // APP SETTINGS
    // Global app settings, only writable by admins.
    match /appSettings/global {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // USERS
    // Users can read all profiles (for leaderboards).
    // An admin can update a user's points and wins count for settling bets.
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow a user to create their own profile upon first sign-in.
      allow create: if request.auth.uid == userId;
      // Allow user to update their own profile, but not critical fields.
      // Allow an admin to update ONLY points and wins count for settling bets.
      allow update: if request.auth.uid == userId || 
                     (isAdmin() && request.resource.data.diff(resource.data).affectedKeys.hasOnly(['points', 'winsCount']));
    }

    // BETTING ROUNDS
    // Admins can only create rounds if betting is enabled.
    // Users can only place bets (update 'bets' and 'bettorIds' fields) if betting is enabled.
    // Admins can only update results if betting is enabled.
    match /bettingRounds/{roundId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && isBettingGloballyEnabled();
      allow update: if (isAdmin() && isBettingGloballyEnabled()) || 
                     (isBettingGloballyEnabled() && request.auth != null && request.resource.data.diff(resource.data).affectedKeys.hasOnly(['bets', 'bettorIds']));
    }

    // TEAM DIVISION
    // Every signed-in user reads the roster and the published division, but only
    // an admin owns it: members may spin locally, that result is never written.
    match /teamDivision/latest {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // GLOBAL PLAYERS
    // A shared list of players for all tournaments.
    match /globalPlayers/{playerId} {
      allow read: if true; // Allow public read for player names
      // Any authenticated user can manage the global player list.
      allow write: if request.auth != null;
    }

    // TOURNAMENTS
    // Tournament data is public and can be read by anyone.
    // Any authenticated user is allowed to write (create, update, delete) tournament data.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}