
rules_version = '2';

// VNext Football Hub Firestore Rules

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the requesting user has the 'admin' role.
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS
    // Users can read all profiles (for leaderboards).
    // An admin can update a user's points and wins count for settling bets.
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow a user to create their own profile upon first sign-in.
      allow create: if request.auth.uid == userId;
      // Allow user to update their own profile, but not critical fields.
      // Allow an admin to update ONLY points and wins count for settling bets.
      allow update: if request.auth.uid == userId || 
                     (isAdmin() && request.resource.data.diff(resource.data).affectedKeys.hasOnly(['points', 'winsCount']));
    }

    // BETTING ROUNDS
    // Rounds are readable by authenticated users. Admins create/update results.
    // Users can update a round ONLY to place a bet.
    match /bettingRounds/{roundId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      
      // Allow updates if the user is an Admin.
      // Also allow updates from any authenticated user IF they are only changing the 'bets'
      // and 'bettorIds' fields. This is what happens during a placeBet transaction.
      allow update: if isAdmin() || 
                     (request.auth != null && request.resource.data.diff(resource.data).affectedKeys.hasOnly(['bets', 'bettorIds']));
    }

    // TEAM DIVISION
    // The 'latest' document can be read and written to by any authenticated user.
    match /teamDivision/latest {
      allow read, write: if request.auth != null;
    }

    // GLOBAL PLAYERS
    // A shared list of players for all tournaments.
    match /globalPlayers/{playerId} {
      allow read: if request.auth != null;
      // Any authenticated user can manage the global player list.
      allow write: if request.auth != null;
    }

    // TOURNAMENTS
    // Tournament data is public and can be read by anyone.
    // Any authenticated user is allowed to write (create, update, delete) tournament data.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}