{
  "name": "vnext-football-hub",
  "version": "1.0.0",
  "description": "Football Bet Hub application",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && cd functions && npm install && npm run build && cd .. && firebase deploy",
    "lint:functions": "npm --prefix functions run lint",
    "build:functions": "npm --prefix functions run build",
    "deploy:functions": "npm run lint:functions && npm run build:functions && firebase deploy --only functions"
  },
  "keywords": [
    "react",
    "firebase",
    "football",
    "betting"
  ],
  "author": "VNext",
  "license": "UNLICENSED",
  "devDependencies": {
    "dotenv": "^16.3.1",
    "dotenv-cli": "^7.0.0",
    "esbuild": "^0.19.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "firebase": "^12.0.0",
    "motion": "^13.1.1",
    "three": "^0.185.1"
  }
}
